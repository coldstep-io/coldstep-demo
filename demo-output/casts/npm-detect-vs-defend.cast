[5.477, "o", "\u001b[1m# coldstep detect digest - npm\u001b[0m\r\n"]
[5.517, "o", "\r\n"]
[5.557, "o", "\u001b[2mInstall: npm install express && npm install @aws-sdk/client-s3\u001b[0m\r\n"]
[5.597, "o", "\r\n"]
[5.637, "o", "\u001b[1m## IPv4 egress\u001b[0m  \u001b[2m(every destination the install touched)\u001b[0m\r\n"]
[5.677, "o", "\r\n"]
[5.717, "o", "  destination       port   by                 policy    events\r\n"]
[5.757, "o", "  ---------------   ----   ----------------   -------   ------\r\n"]
[5.797, "o", "  \u001b[33m104.16.4.34\u001b[0m       443    npm install exp    monitor       17\r\n"]
[5.837, "o", "  \u001b[33m168.63.129.16\u001b[0m     53,80  python3 (Azure)    monitor       14   \u001b[2m<- cloud metadata\u001b[0m\r\n"]
[5.877, "o", "  \u001b[33m140.82.112.22\u001b[0m     443    node (GH Actions)  monitor        1\r\n"]
[5.917, "o", "\r\n"]
[5.957, "o", "\u001b[1m## TLS SNI\u001b[0m  \u001b[2m(logical hosts inside the TLS sessions)\u001b[0m\r\n"]
